+_NUM_DEFAULTS = dict(gst=18.0, mrp=0.0, cost=0.0, stock=0.0, reorder=5.0)
+
+def product_rows(d):
+    """Active products as plain dicts. NULL / blank / text numbers (e.g. from a CSV import
+    straight into the DB) are coerced so the products & inventory pages never crash."""
+    out = []
+    for r in d.execute("select * from products where active=1 order by dept,name").fetchall():
+        r = dict(r)
+        for k, dflt in _NUM_DEFAULTS.items():
+            r[k] = num(r.get(k), dflt)
+        r["dept"] = (r.get("dept") or "").strip() or "General"
+        r["name"] = r.get("name") or ""
+        r["barcode"] = r.get("barcode") or ""
+        out.append(r)
+    return out
